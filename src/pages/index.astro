---
import Base from '../layouts/Base.astro';
import '../styles/global.css';

const title = 'Hypermemetic';
const description = 'Serious infrastructure for small teams. Multi-tenant platform, open source, consultancy-grade.';
---
<Base title={title} description={description}>
  <main class="page">
    <a href="/" class="brand" aria-label="Hypermemetic home">
      <span class="brand-mark" aria-hidden="true">H</span>
      <span>Hypermemetic</span>
    </a>

    <section class="hero">
      <h1>Serious infrastructure, small team.</h1>
      <p class="lede">
        We're building the part of the stack most small teams shouldn't have
        to rebuild &mdash; open source, self-hostable, and cheap to run.
      </p>
    </section>

    <section>
      <h2>What we're building</h2>
      <p>
        A multi-tenant platform that onboards clients, provisions their sites
        and backends, and keeps spend predictable. The platform runs itself
        &mdash; this page is deployed through it.
      </p>
      <p>
        Everything we ship is usable standalone: the platform crate, the
        schema-driven CLI, the repo-management tools. Take any piece and
        run it on your own box.
      </p>
    </section>

    <section>
      <h2>Principles</h2>
      <ul class="principles">
        <li>
          <strong>Own your platform.</strong>
          <span>OSS from day one. You can always take it and leave.</span>
        </li>
        <li>
          <strong>Typed contracts.</strong>
          <span>Every method is a schema. Flags are discovered, not guessed.</span>
        </li>
        <li>
          <strong>Cheap first.</strong>
          <span>Free-tier by default. You opt into spend &mdash; never surprised.</span>
        </li>
        <li>
          <strong>Consultancy-grade.</strong>
          <span>If it can't survive a real engagement, it doesn't ship.</span>
        </li>
      </ul>
    </section>

    <section>
      <h2>Status</h2>
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        Platform core is running. Consultancy engagements open mid-2026.
      </p>
    </section>

    <footer class="footer">
      <span>
        <a href="mailto:hypermemetic@proton.me">hypermemetic@proton.me</a>
      </span>
      <span>
        <a href="https://github.com/hypermemetic">github.com/hypermemetic</a>
      </span>
      <span class="meta">hypermemetic / v0.1 / <time datetime="2026-04-24">04 · 2026</time></span>
    </footer>
  </main>
</Base>
